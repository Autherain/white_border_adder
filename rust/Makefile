VERSION := $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
PREFIX  := $(HOME)/.local
BINARY  := target/release/wba

.PHONY: lint test build install clean

lint:
	cargo fmt --all --check
	cargo clippy --all-targets -- -D warnings

test:
	cargo test

build:
	WBA_VERSION=$(VERSION) cargo build --release

# The completion script is generated by the binary itself, so installing a
# new build is all it takes to keep it in sync.
install: build
	mkdir -p $(PREFIX)/bin $(PREFIX)/share/zsh/site-functions $(PREFIX)/share/bash-completion/completions
	cp $(BINARY) $(PREFIX)/bin/wba
	$(PREFIX)/bin/wba completion zsh > $(PREFIX)/share/zsh/site-functions/_wba
	$(PREFIX)/bin/wba completion bash > $(PREFIX)/share/bash-completion/completions/wba

clean:
	cargo clean
