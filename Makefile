BINARY  := wba
VERSION := $(shell git describe --tags --always --dirty 2>/dev/null || echo dev)
LDFLAGS := -ldflags "-s -w -X github.com/evaneecloo/white_border_adder/internal/cli.version=$(VERSION)"

PREFIX  := $(HOME)/.local

.PHONY: lint test build build-windows install clean

lint:
	golangci-lint run ./...

test:
	go test ./...

build:
	go build $(LDFLAGS) -o $(BINARY) ./cmd/wba

build-windows:
	GOOS=windows GOARCH=amd64 go build $(LDFLAGS) -o $(BINARY).exe ./cmd/wba

# The completion script is generated by the binary itself, so installing a
# new build is all it takes to keep it in sync.
install: build
	mkdir -p $(PREFIX)/bin $(PREFIX)/share/zsh/site-functions $(PREFIX)/share/bash-completion/completions
	cp $(BINARY) $(PREFIX)/bin/$(BINARY)
	$(PREFIX)/bin/$(BINARY) completion zsh > $(PREFIX)/share/zsh/site-functions/_$(BINARY)
	$(PREFIX)/bin/$(BINARY) completion bash > $(PREFIX)/share/bash-completion/completions/$(BINARY)

clean:
	rm -f $(BINARY) $(BINARY).exe
